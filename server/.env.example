# ==== גוב ארי — הגדרות שרת ההזמנות / לידים ====
# העתק קובץ זה ל-.env ומלא את הערכים. אל תעלה את .env לגיט.
# בפרודקשן (Vercel) — הגדר את אותם מפתחות ב-Settings → Environment Variables.

# --- כללי ---
PORT=3000
# כתובת האתר (קישורי חזרה, מיילים). בפרודקשן: https://<הדומיין>
SITE_URL=http://localhost:3000
# הגשת האתר הסטטי מהשרת (true) או API בלבד (false). ב-Vercel: false
SERVE_SITE=true
# מלח לגיבוב IP (לא שומרים IP גולמי). בפרודקשן: מחרוזת אקראית ארוכה.
IP_HASH_SALT=

# --- מסד נתונים (PostgreSQL) ---
# ריק = אחסון בקובץ JSON מקומי (dev בלבד, ארעי).
# בפרודקשן: מחרוזת חיבור מ-Supabase — Transaction pooler, פורט 6543:
#   postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=
# ספקי Postgres מנוהלים דורשים SSL (השאר true).
PGSSL=true

# --- מייל (Resend) ---
# מפתח API מ-https://resend.com  (Dashboard → API Keys). ריק = התראות מחכות ב-outbox.
RESEND_API_KEY=
# כתובת "מאת" — חייבת להיות בדומיין מאומת ב-Resend. לבדיקה: onboarding@resend.dev
FROM_EMAIL=onboarding@resend.dev
FROM_NAME=גוב ארי מערכות
# לכאן מגיעה התראה על כל ליד / הזמנה חדשה:
OWNER_EMAIL=davidazulay75@gmail.com

# --- Meta Pixel + Conversions API (מדידה) ---
# ריק = מדידת שרת כבויה (הפיקסל בדפדפן מוגדר ב-site/js/config.js בנפרד).
META_PIXEL_ID=
META_CAPI_TOKEN=
# קוד Test Events — לבדיקה בלבד, השאר ריק בפרודקשן.
META_TEST_EVENT_CODE=

# --- אדמין לידים (/admin/leads) ---
# ריק = הנתיב כבוי (משתמשים בדשבורד Supabase). שניהם נדרשים כדי להפעיל.
ADMIN_USER=
ADMIN_PASSWORD=

# --- Outbox tick (הפעלה חיצונית של פועל ההתראות) ---
# סוד ל-cron-job.org כשה-cron של Vercel לא זמין (Hobby). ריק = הגנת Cron header בלבד.
OUTBOX_TICK_SECRET=
# גיבוי אופציונלי ל-Google Sheet (Apps Script Web App URL). לעולם לא מקור אמת.
SHEET_WEBHOOK_URL=

# --- סליקה ---
# none = ללא סליקה (ליד נשמר + מייל נשלח, ללא חיוב).
# כשמחברים ספק: הגדר את שמו ומלא מפתחות, והשלם את src/payment.js
PAYMENT_PROVIDER=none
PAYMENT_API_URL=
PAYMENT_API_KEY=
PAYMENT_SECRET=
# סוד לאימות ה-webhook מהספק (חתימה)
PAYMENT_WEBHOOK_SECRET=

# --- מוצר (ברירת מחדל) ---
PRODUCT_NAME=מצלמת רכב גוב ארי — 4 ערוצים
PRODUCT_PRICE=1090
CURRENCY=ILS
